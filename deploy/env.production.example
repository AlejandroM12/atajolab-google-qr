# Copiar a /etc/atajolab-google-qr.env o al panel de Render (modo 600 / secret).
# No guardar valores reales en el repositorio ni usar el .env local.

APP_URL=https://qr.atajolab.dev
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-DIRECTO/neondb?sslmode=require

# Mercado Pago Checkout Pro (pestaña Producción)
MERCADOPAGO_ENV=production
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://qr.atajolab.dev/api/payments/mercadopago

# Correo (Resend, dominio verificado — no @resend.dev en production)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=AtajoLab <pedidos@mail.atajolab.dev>

# Studio v8 — secretos de servidor (≥32 / ≥16). No van al navegador.
ORDER_ACCESS_SECRET=
MAIL_DISPATCH_SECRET=
STUDIO_CLEANUP_SECRET=

# Flags. Checkout Studio off hasta GO F2. Export preview off recomendado.
STUDIO_CHECKOUT_ENABLED=
STUDIO_EXPORT_ENABLED=

# Rate-limit IP. Vacío = no confiar headers (recomendado hasta origin lockdown).
# cloudflare solo si el origen Render acepta únicamente IPs de Cloudflare.
RATE_LIMIT_TRUST_PROXY=

# Crons (configurar en el panel; no en este archivo):
#   cada 1–5 min  POST https://qr.atajolab.dev/api/mail/dispatch
#                 Authorization: Bearer $MAIL_DISPATCH_SECRET
#   cada 1 h      POST https://qr.atajolab.dev/api/studio/assets/cleanup
#                 Authorization: Bearer $STUDIO_CLEANUP_SECRET
#
# Migraciones (tras backup Neon):
#   pnpm exec prisma migrate deploy

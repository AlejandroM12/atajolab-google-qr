# Plantilla local. No pongas claves reales.
# Los valores de producción se cargan en el panel del hosting y no se commitean.
POSTGRES_PASSWORD=cambiar-esta-clave-local
DATABASE_URL=postgresql://atajolab:cambiar-esta-clave-local@127.0.0.1:54329/atajolab_google_qr

# Origen público de esta aplicación. Tiene que coincidir con la URL de `pnpm dev`.
APP_URL=http://localhost:3001

# test habilita Checkout Pro de prueba. Cualquier otro valor deja el cobro deshabilitado.
MERCADOPAGO_ENV=test

# Access token de la pestaña Prueba. En Checkout Pro empieza con APP_USR-.
# No pegar el token de la pestaña Producción: el prefijo es igual y no se puede distinguir.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública https que Mercado Pago usa para notificar pagos.
# En local hace falta un túnel, por ejemplo:
#   cloudflared tunnel --url http://localhost:3001
# y entonces:
#   MERCADOPAGO_NOTIFICATION_URL=https://<tunel>/api/payments/mercadopago
# Sin una URL https, el servidor omite notification_url. No publiques el entorno local.
MERCADOPAGO_NOTIFICATION_URL=

# Correo transaccional. Estas variables se leen solo en el servidor.
# No uses el prefijo NEXT_PUBLIC_ y no las subas al repositorio.
# En desarrollo, con EMAIL_PROVIDER vacío, el mensaje queda en .data/mail-outbox.jsonl.
# Para activar Resend: EMAIL_PROVIDER=resend, una API key que empiece con re_
# y un remitente email@dominio o Nombre <email@dominio> de un dominio verificado.
# Si falta la configuración o Resend rechaza el envío, el enlace no queda activo.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Producción: estas variables no las lee el código. No las completes en este entorno.
# MERCADOPAGO_ACCESS_TOKEN_LIVE=
# MERCADOPAGO_WEBHOOK_SECRET_LIVE=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Solo un aviso de pago confirmado, del lado del servidor, puede salir de PENDING.
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id                      String      @id
  status                  OrderStatus @default(PENDING)
  amountArs               Int
  currency                String      @default("ARS")
  artworkVersion          Int
  artwork                 Json
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  deliveryKeyHash          String?
  mercadoPagoPreferenceId  String?     @unique
  mercadoPagoPaymentId     String?     @unique
  mercadoPagoPaymentStatus String?
  paymentCheckedAt         DateTime?
  paidAt                   DateTime?
  /// Correo normalizado. Los pedidos anteriores quedan en null.
  buyerEmail               String?
  accessLinks              DownloadAccessLink[]
  accessCredentials        DownloadAccessCredential[]
  studioAssets             StudioAsset[]

  @@index([buyerEmail])
}

/// TEMPORARY: borrador Studio (expira). RETAINED: ligado a un pedido, no limpia.
enum StudioAssetStatus {
  TEMPORARY
  RETAINED
}

/// Bytes privados de Studio v8. No se sirven por URL pública.
model StudioAsset {
  id           String            @id
  sha256       String
  mime         String
  width        Int
  height       Int
  byteLength   Int
  bytes        Bytes
  status       StudioAssetStatus @default(TEMPORARY)
  /// Hash del draft key del borrador. Obligatorio mientras TEMPORARY.
  draftKeyHash String?
  /// Pedido que retiene el asset. Null mientras es temporal.
  orderId      String?
  createdAt    DateTime          @default(now())
  /// Solo TEMPORARY. RETAINED queda en null.
  expiresAt    DateTime?
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sha256])
  @@index([draftKeyHash, status])
  @@index([orderId])
  @@index([status, expiresAt])
  @@unique([draftKeyHash, sha256])
}

/// El id es el hash del token. El token en claro no se guarda.
model DownloadAccessLink {
  tokenHash String    @id
  orderId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, usedAt])
}

/// Clave extra de descarga. No reemplaza deliveryKeyHash del pedido.
model DownloadAccessCredential {
  keyHash   String   @id
  orderId   String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
